<%- include("partials/header.ejs") %>

<div class="container">
  <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom border-secondary border-opacity-25">
    <h1 class="h3 fw-bold mb-0">All Blogs</h1>
    <a href="/" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i> New Post</a>
  </div>

  <% if (blogs.length === 0) { %>
    <div class="custom-card p-5 text-center my-4">
      <p class="text-secondary mb-3">No blogs found.</p>
      <a href="/" class="btn btn-primary">Create Your First Blog</a>
    </div>
  <% } else { %>
    <div class="row g-4">
      <% blogs.forEach((post) => { %>
        <div class="col-md-6 col-lg-4">
          <div class="custom-card h-100 p-4 d-flex flex-column justify-content-between">
            <div>
              <small class="text-secondary d-block mb-2">
                <%= post.created_at ? new Date(post.created_at).toLocaleDateString() : '' %>
              </small>
              <h2 class="h5 mb-3">
                <a href="/blogs/<%= post.id %>" class="blog-card-title">
                  <%= post.title %>
                </a>
              </h2>
              <p class="text-secondary small mb-4">
                <%= post.text.length > 120 ? post.text.substring(0, 120) + '...' : post.text %>
              </p>
            </div>
            <div>
              <a href="/blogs/<%= post.id %>" class="btn btn-outline-light btn-sm">Read Post</a>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
  <% } %>
</div>

<%- include("partials/footer.ejs") %>